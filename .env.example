# ==============================================================================
# UniDetect Backend Configuration
# ==============================================================================

# Application
APP_NAME=UniDetect Backend
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ML Model Provider: "mock", "local", or "external"
# Use "mock" for local dev before Person 2 delivers the model artifact.
# Switch to "local" once models/unidetect_model.joblib is in place.
MODEL_PROVIDER=mock
MODEL_PATH=models/unidetect_model.joblib
MODEL_NAME=unidetect_threat_classifier
MODEL_VERSION=0.1.0-dev
SCHEMA_VERSION=78d-v1

# External Model Service (For future remote ML microservice)
MODEL_API_URL=
MODEL_API_KEY=
REQUEST_TIMEOUT_SECONDS=15.0
